#include <bits/stdc++.h>
#define CPPHTTPLIB_OPENSSL_SUPPORT
#include "httplib.h"
#include "json.hpp"
using namespace std;
using json=nlohmann::json;
string provider="logfare.ai";
string web_provider="api.langsearch.com";
string model="deepseek-v4.1-flash-1017";
httplib::SSLClient cli(provider);
httplib::SSLClient web_cli(web_provider);
string promptfile="sysprompts/clover.txt";
string toolh="[TOOL]";
string toolcontinue="<continue>";
string system_prompt;
string toolrestag="[tool results]";
string generate(string model, json context){
    json m; m["model"]=model;
    m["stream"]=false;
    //m["reasoning"]=false;
    //m["reasoning_effort"]="max";
    m["messages"]=context;
    auto res=cli.Post("/v1/chat/completions", m.dump(), "application/json");
    if (res && (*res).status==200){
        try{
            auto resp_json=json::parse((*res).body);
            string resp=resp_json["choices"][0]["message"]["content"];
            return resp;
        } catch (const json::parse_error& e){
            cerr<<"response json parse error:\n"<<e.what()<<'\n';
        }
    } else{
        cerr<<"http error:\n";
        if (res){
            cerr<<"status code "<<(*res).status<<'\n';
            cout<<"body: \n"<<(*res).body<<'\n';
        } else{
            cerr<<"failed to connect\n";
        }
    }
    return "";
}
//<tools>
string get_time(){
    auto timenow=chrono::system_clock::to_time_t(chrono::system_clock::now());
    return "current time: " + (string)asctime(gmtime(&timenow));
}
string web_search(string query){
    cout<<"web search: "<<query<<'\n';
    json m; m["query"]=query;
    m["count"]=10;
    m["contents"]={{"text",true}};
    m["freshness"]="noLimit";
    auto res=web_cli.Post("/v1/web-search", m.dump(), "application/json");
    if (res && (*res).status==200){
        try{
            auto resp_json=json::parse((*res).body);
            string resp=to_string(resp_json);
            return resp;
        } catch (const json::parse_error& e){
            cerr<<"web search response json parse error:\n"<<e.what()<<'\n';
        }
    } else{
        cerr<<"web search http error:\n";
        if (res){
            cerr<<"status code "<<(*res).status<<'\n';
            cout<<"body: \n"<<(*res).body<<'\n';
        } else{
            cerr<<"failed to connect\n";
        }
    }
    return "";
}
string run_command(string rcommand){
    cout<<"ran command: "<<rcommand<<'\n';
    string command="'";
    for (char c:rcommand){
        if (c=='\'') command+="'\\''";
        else command+=c;
    }
    command+="'";
    string full_command="bash -lc "+command+" 2>&1";
    FILE* pipe=popen(full_command.c_str(), "r");
    if (!pipe) {cerr<<"popen failed\n"; return "popen failed";}
    string output;
    for (int c; (c=fgetc(pipe))!=EOF;) output.push_back(static_cast<char>(c));
    int status=pclose(pipe);
    int excode=-1;
    if (WIFEXITED(status)) excode=WEXITSTATUS(status);
    else if (WIFSIGNALED(status)) excode=128+WTERMSIG(status);
    return "exit code: "+to_string(excode)+"\nresult: "+move(output)+'\n';
}
//</tools>
class agent{
    public:
        string model;
        string name;
        json ctx;
        agent(string modelname, string sysprompt, string agentname){
            model=modelname;
            name=agentname;
            ctx.push_back({{"role", "system"}, {"content", sysprompt}});
        }
        void clear_context(){
            while (ctx.size()>1) ctx.erase(ctx.size()-1);
        }
        string f(string msg){
            // cout<<"[fndhr] called f\n";
            ctx.push_back({{"role", "user"}, {"content", msg}});
            string rsp=generate(model, ctx);
            // cout<<"[fndhr] raw response:\n"<<rsp<<'\n';
            ctx.push_back({{"role", "assistant"}, {"content", rsp}});
            int toolpos=-1;
            int found=rsp.find(toolh);
            if (found!=string::npos) toolpos=found;
            if (toolpos!=-1){
                for (int i=0;i<toolpos;i++) cout<<rsp[i];
                string toolstring=rsp.substr(toolpos+toolh.size());
                int ofound=toolstring.find('[');
                int cfound=toolstring.find(']');
                if (ofound==string::npos || cfound==string::npos || cfound<ofound){
                    cerr<<"malformed tool call, missing json array\n";
                    cerr<<"raw: \n"<<rsp<<'\n';
                    return "";
		        }
		        toolstring=toolstring.substr(ofound);
                while (toolstring.size() && toolstring.back()!=']') toolstring.pop_back();
                json tool_json;
                try{
                    tool_json=json::parse(toolstring);
                } catch (const json::parse_error& e){
                    cerr<<"tool json parse error:\n"<<e.what()<<'\n';
                }
                string toolres=toolrestag+"\n";
                for (auto tool:tool_json){
                    toolres+="tool result, id: "+to_string(tool["id"].get<int>())+'\n';
                    toolres+="tool name: "+tool["tool"].get<string>()+'\n';
                    cout<<"[tool: "<<tool["tool"].get<string>()<<"]\n";
                    if (tool["tool"].get<string>()=="get_time"){
                        toolres+=get_time();
                    } else if (tool["tool"].get<string>()=="web_search"){
                        toolres+=web_search(tool["query"].get<string>());
                    } else if (tool["tool"].get<string>()=="run_command"){
                        toolres+=run_command(tool["command"].get<string>());
                    }else{
                        toolres+="unknown tool\n";
                    }
                }
                ctx.push_back({{"role", "user"}, {"content", toolres}});
                return f(toolcontinue);
            } else {
                return rsp+'\n';
            }
        }
};
void run_convo(agent a){
    while (true){
        string message;
        string line="";
        cout<<"→ ";
        getline(cin, line);
        if (line=="\"\"\""){
            while (true){
                getline(cin, line);
                if (line=="\"\"\"") break;
                message+=line+'\n';
            }
        } else message=line;
        stringstream ss(message);
        string unus;
        vector<string> cmd{};
        while (ss>>unus) cmd.push_back(unus);
        if (!cmd.size()) continue;
        if (cmd[0]=="/clear_ctx"){
            a.clear_context();
        } else if (cmd[0]=="/model"){
            if (cmd.size()>1) model=cmd[1];
            else cout<<"usage: /model [model]";
        } else if (cmd[0]=="/provider"){
            if (cmd.size()>1) provider=cmd[1];
            else cout<<"usage: /provider [provider]";
        }else {
            cout<<'['<<a.name<<" :: "<<provider<<'/'<<model<<"]\n";
            cout<<a.f(message);
        }
    }
}
int main(){
    cli.set_keep_alive(false);
    cli.set_connection_timeout(0,3000000);
    ifstream sysfile(promptfile);
    if (!sysfile.is_open()){
        cerr<<"could not open sysprompt file "<<promptfile<<'\n';
        return 1;
    }
    stringstream buf; buf<<sysfile.rdbuf();
    system_prompt=buf.str();
    cli.set_default_headers({{"Authorization", "Bearer "+chat_key}});
    web_cli.set_default_headers({{"Authorization", "Bearer "+web_key}});
    agent astrae(model, system_prompt, "☘ clover");
    run_convo(astrae);
    return 0;
}
